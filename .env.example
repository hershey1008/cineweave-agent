# Copy to .env; choose independent secrets. Never commit the real .env.
DB_PASSWORD=please-replace
SECRET_KEY=please-replace-with-a-long-random-secret
FUNREC_RAW_DATA_PATH=./artifacts/data
FUNREC_MODELS_PATH=./artifacts/processed/web_project/deployed_models
# Optional host-side offline training output root.
FUNREC_PROCESSED_DATA_PATH=./artifacts/processed
BACKEND_DOCKERFILE=Dockerfile
SEMANTIC_DOCKERFILE=Dockerfile
FRONTEND_DOCKERFILE=dockerfile
SEMANTIC_INDEX_VERSION=
CHAT_TIMEOUT=20
SEMANTIC_TIMEOUT=10
# Empty means an explicitly labelled local rules demonstration.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Shared deadline for initial intent call and one optional JSON repair.
LLM_TIMEOUT_SECONDS=45
# Explicit orchestration comparison / rollback; no automatic fallback.
AGENT_ORCHESTRATOR=langgraph
# Demo account password is for loopback-only local demonstration.
DEMO_PASSWORD=CineweaveDemo!2026
